# Secrets — NEVER commit. The guild token authenticates as the guild; leaking it
# lets anyone control Stanley_Steemer. Belt-and-suspenders: the pre-commit hook
# in .githooks/ also hard-blocks these.
guild_token.json
*token*.json
*.token
.env
.env.*

# DB config carries the mariadb password (authenticates as the guild's datastore).
config.toml
config.json

# advice.md is the transient handoff analyze-iteration.sh writes for
# apply-iteration.sh to consume — regenerated each run, never committed.
orchestrator/advice.md

# Local databases (raw frame mirror, metrics, decisions) — large and machine-local.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# reaper reverse-sync results directory (always local)
out/

# editor/OS noise
*.swp
.DS_Store

# live supervisor log
steemer-live.log
*.log

# local archive staging (frames shipped off-box, then pruned)
/archive/

# svc.sh runtime state: pid files + service logs (bot log already listed above)
/run/
web-sidecar.log
ui-server.log

# analyze-iteration.sh's local window cursor (which window it last advised on)
orchestrator/.analyze-window
# the analyze->apply handoff file (regenerated each analyze pass)
orchestrator/advice.md

# crash dumps (a segfaulting runner drops these in the repo root)
*.core
